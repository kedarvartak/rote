{
  "name": "@rote/bench",
  "version": "0.0.0",
  "private": true,
  "description": "Benchmark harness for Rote's M3 run-it-twice economics gate",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "rote-bench": "./bin/rote-bench.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:enterprise-chrome": "ROTE_RUN_CDP_TESTS=1 vitest run test/enterprise-real-chrome.test.ts",
    "test:enterprise-context-chrome": "ROTE_RUN_CDP_TESTS=1 vitest run test/enterprise-composed-context-real-chrome.test.ts",
    "test:enterprise-verbs-chrome": "ROTE_RUN_CDP_TESTS=1 vitest run test/enterprise-verbs-real-chrome.test.ts",
    "test:enterprise-endurance-chrome": "ROTE_RUN_CDP_TESTS=1 vitest run test/enterprise-endurance-real-chrome.test.ts",
    "build": "tsc -p tsconfig.json",
    "test:enterprise-continuation-chrome": "ROTE_RUN_CDP_TESTS=1 vitest run test/enterprise-continuation-real-chrome.test.ts"
  },
  "dependencies": {
    "@rote/action": "*",
    "@rote/agent": "*",
    "@rote/browser": "*",
    "@rote/continuation": "*",
    "@rote/core": "*",
    "@rote/executor": "*",
    "@rote/perception": "*",
    "@rote/recorder": "*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
