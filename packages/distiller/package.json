{
  "name": "@rote/distiller",
  "version": "0.0.0",
  "private": true,
  "description": "Trajectory → playbook distiller for Rote (tier 1, episodic memory)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:distill-chrome": "ROTE_RUN_CDP_TESTS=1 vitest run test/invariants/distilled-playbook-replays-real-chrome.test.ts",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@rote/core": "*",
    "@rote/recorder": "*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@rote/action": "*",
    "@rote/agent": "*",
    "@rote/browser": "*",
    "@rote/executor": "*",
    "@types/node": "^22.9.0",
    "fast-check": "^3.23.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
