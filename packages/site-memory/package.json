{
  "name": "@rote/site-memory",
  "version": "0.0.0",
  "private": true,
  "description": "Tier-2 site memory for Rote: append-only, per-fingerprint, advisory records of how a site behaves",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "test:settle-chrome": "ROTE_RUN_CDP_TESTS=1 vitest run test/cdp-settle-priors-end-to-end.test.ts"
  },
  "dependencies": {
    "@rote/core": "*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@rote/agent": "*",
    "@rote/browser": "*",
    "@rote/distiller": "*",
    "@types/node": "^22.9.0",
    "fast-check": "^3.23.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
